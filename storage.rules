rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isImageContentType() {
      return request.resource.contentType in ['image/jpeg', 'image/png', 'image/heic'];
    }

    function hasValidGpsMetadata() {
      return request.resource.metadata.latitude is string
        && request.resource.metadata.longitude is string
        && request.resource.metadata.latitude.matches('^-?[0-9]+(\\.[0-9]+)?$')
        && request.resource.metadata.longitude.matches('^-?[0-9]+(\\.[0-9]+)?$')
        && request.resource.metadata.latitude.matches('^((39\.(8[0-9]*|9[0-9]*))|(40\.(0[0-9]*|1[0-9]*|2[0-9]*)))$')
        && request.resource.metadata.longitude.matches('^(-75\.(0[0-9]*|1[0-9]*|2[0-9]*|3[0-9]*))|(-74\.(9[0-9]*))$');
    }

    match /submissions/{userId}/{fileName} {
      allow read: if isAuthenticated();

      allow write: if isOwner(userId)
        && request.resource.size <= 5 * 1024 * 1024
        && isImageContentType()
        && hasValidGpsMetadata();
    }
  }
}
