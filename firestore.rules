rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidLatLng(location) {
      return location is map
        && location.latitude is number
        && location.longitude is number
        && location.latitude >= -90 && location.latitude <= 90
        && location.longitude >= -180 && location.longitude <= 180;
    }

    function isValidSeverity(severity) {
      return severity is int && severity >= 1 && severity <= 5;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'id',
          'email',
          'displayName',
          'photoUrl',
          'reputationScore',
          'totalReports',
          'milesDriven',
          'createdAt',
          'lastActive'
        ])
        && request.resource.data.id == userId
        && request.resource.data.email is string
        && (request.resource.data.displayName is string
          || request.resource.data.displayName == null)
        && (request.resource.data.photoUrl is string
          || request.resource.data.photoUrl == null)
        && request.resource.data.reputationScore is int
        && request.resource.data.totalReports is int
        && request.resource.data.milesDriven is number
        && request.resource.data.createdAt is timestamp
        && request.resource.data.lastActive is timestamp;
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'displayName',
          'photoUrl',
          'lastActive',
          'milesDriven'
        ])
        && request.resource.data.id == resource.data.id
        && request.resource.data.email == resource.data.email
        && request.resource.data.reputationScore == resource.data.reputationScore
        && request.resource.data.totalReports == resource.data.totalReports
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.displayName is string
          || request.resource.data.displayName == null)
        && (request.resource.data.photoUrl is string
          || request.resource.data.photoUrl == null)
        && request.resource.data.milesDriven is number
        && request.resource.data.lastActive is timestamp;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'reputationScore',
          'totalReports',
          'lastActive',
          'milesDriven'
        ])
        && request.resource.data.id == resource.data.id
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.reputationScore is int
        && request.resource.data.totalReports is int
        && request.resource.data.milesDriven is number
        && request.resource.data.lastActive is timestamp;
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /submissions/{submissionId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly([
          'id',
          'userId',
          'userEmail',
          'photoUrl',
          'location',
          'severity',
          'notes',
          'status',
          'submittedAt',
          'reviewedAt',
          'reviewedBy',
          'rejectionReason',
          'createdSpeedBumpId'
        ])
        && request.resource.data.id == submissionId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && isValidSeverity(request.resource.data.severity)
        && isValidLatLng(request.resource.data.location)
        && request.resource.data.photoUrl is string
        && request.resource.data.userEmail is string
        && request.resource.data.submittedAt is timestamp
        && (request.resource.data.notes is string
          || request.resource.data.notes == null)
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == null
        && request.resource.data.rejectionReason == null
        && request.resource.data.createdSpeedBumpId == null;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status',
          'reviewedAt',
          'reviewedBy',
          'rejectionReason',
          'createdSpeedBumpId'
        ])
        && request.resource.data.id == resource.data.id
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isAdmin();
    }

    match /speed_bumps/{bumpId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'id',
          'location',
          'severity',
          'reportCount',
          'lastVerified',
          'isVerified'
        ])
        && request.resource.data.id == bumpId
        && isValidSeverity(request.resource.data.severity)
        && isValidLatLng(request.resource.data.location)
        && request.resource.data.reportCount is int
        && request.resource.data.reportCount >= 1
        && request.resource.data.lastVerified is timestamp
        && request.resource.data.isVerified is bool;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'severity',
          'reportCount',
          'lastVerified',
          'isVerified',
          'location'
        ])
        && request.resource.data.id == resource.data.id
        && isValidSeverity(request.resource.data.severity)
        && isValidLatLng(request.resource.data.location)
        && request.resource.data.reportCount is int
        && request.resource.data.reportCount >= 1
        && request.resource.data.lastVerified is timestamp
        && request.resource.data.isVerified is bool;
      allow delete: if isAdmin();
    }
  }
}
